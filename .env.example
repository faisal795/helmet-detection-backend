
# Copy this file to .env and change the secrets before running.

MODEL_PATH=./best.pt
RESULTS_DIR=./results
DATABASE_URL=sqlite:///./helmet_detection.db
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640

JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
ACCESS_TOKEN_MINUTES=60

# Set these to create the first admin on startup.
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=AdminPassword123!
